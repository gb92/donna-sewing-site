---
import { site } from "../lib/site";

const links = [
  { href: "/projects/", label: "Projects" },
  { href: "/journal/", label: "Journal" },
  { href: "/about/", label: "About" }
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.siteName} home`}>
      <img class="brand-mark" src="/brand-mark.svg" alt="" width="138" height="106" />
      <span class="brand-name">{site.siteName}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={pathname.startsWith(href) ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    min-height: 5rem;
  }

  .brand {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark {
    height: auto;
    width: clamp(4rem, 7vw, 4.75rem);
  }

  .brand-name {
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 4vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    color: var(--rose-dark);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 55rem) {
    .header-inner {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      padding-block: 1.25rem;
    }
  }
</style>
