---
interface SocialLink {
  label: string;
  url: string;
}

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

<div class="social-links">
  {links.map((link) => {
    const platform = link.label.toLowerCase();

    return (
      <a href={link.url} rel="me" aria-label={link.label} title={link.label}>
        {platform === "instagram" ? (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.25" />
            <circle class="filled" cx="17.5" cy="6.5" r="1.1" />
          </svg>
        ) : platform === "tiktok" ? (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 3v10.2a4.2 4.2 0 1 1-3.5-4.14v2.63a1.7 1.7 0 1 0 1 1.55V3h2.5c.36 1.88 1.62 3.12 3.5 3.48V9a7 7 0 0 1-3.5-1.38" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10.5 13.5a4 4 0 0 0 5.66 0l2.34-2.34a4 4 0 0 0-5.66-5.66L11.5 6.84M13.5 10.5a4 4 0 0 0-5.66 0L5.5 12.84a4 4 0 0 0 5.66 5.66l1.34-1.34" />
          </svg>
        )}
      </a>
    );
  })}
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  a {
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    display: inline-flex;
    height: 2.5rem;
    justify-content: center;
    transition: background-color 160ms ease, color 160ms ease;
    width: 2.5rem;
  }

  a:hover {
    background: var(--rose);
    color: var(--surface);
  }

  svg {
    fill: none;
    height: 1.25rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 1.25rem;
  }

  .filled {
    fill: currentColor;
    stroke: none;
  }
</style>
