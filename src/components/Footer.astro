---
import { site } from "../lib/site";
---

<footer>
  <div class="container footer-inner">
    <div>
      <strong>{site.siteName}</strong>
      <p>{site.siteDescription}</p>
    </div>
    <div class="links">
      {site.email && <a href={`mailto:${site.email}`}>Email</a>}
      {site.socialLinks.map((link) => <a href={link.url} rel="me">{link.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </div>
    <small>© {new Date().getFullYear()} {site.siteName}</small>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--paper);
    margin-top: 5rem;
    padding-block: 4rem;
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 2fr 1fr auto;
  }

  p {
    color: #d2c8bd;
    margin: 0.4rem 0 0;
    max-width: 34rem;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  small {
    color: #d2c8bd;
  }

  @media (max-width: 45rem) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
