---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing required about page content.");
const { Content } = await render(about);
---

<BaseLayout title="About">
  <article class="about container">
    <div class="about-copy">
      <span class="eyebrow">{about.data.eyebrow}</span>
      <h1>{about.data.title}</h1>
      <div class="prose"><Content /></div>
      {(site.email || site.socialLinks.length > 0) && (
        <div class="contact">
          <h2>Say hello</h2>
          <p>
            {site.email && <a class="text-link" href={`mailto:${site.email}`}>Send an email</a>}
            {site.socialLinks.map((link) => <a class="text-link" href={link.url} rel="me">{link.label}</a>)}
          </p>
        </div>
      )}
    </div>
    {about.data.portrait && (
      <Image class="portrait" src={about.data.portrait} alt={about.data.portraitAlt ?? ""} />
    )}
  </article>
</BaseLayout>

<style>
  .about {
    align-items: start;
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 1.1fr 0.9fr;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  h1 {
    margin: 0.4rem 0 2rem;
  }

  .prose {
    margin: 0;
  }

  :global(.portrait) {
    border-radius: 48% 48% 1rem 1rem;
    box-shadow: var(--shadow);
    width: 100%;
  }

  .contact {
    border-top: 1px solid var(--line);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .contact h2 {
    font-size: 2rem;
    margin: 0;
  }

  .contact p {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  @media (max-width: 45rem) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
