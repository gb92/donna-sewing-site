---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../lib/site";
import { isPublished, newestFirst } from "../lib/content";
import heroImage from "../assets/images/thread-and-fabric.svg";

const projects = newestFirst((await getCollection("projects")).filter(isPublished));
const journal = newestFirst((await getCollection("journal")).filter(isPublished));
const featuredProjects = projects.filter((entry) => entry.data.featured).slice(0, 3);
const shownProjects = featuredProjects.length ? featuredProjects : projects.slice(0, 3);
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow">{site.heroEyebrow}</span>
      <h1>{site.heroTitle}</h1>
      <p>{site.heroText}</p>
      <a class="button" href="/projects/">See the projects</a>
    </div>
    <div class="hero-image">
      <Image src={heroImage} alt="Spools of thread, fabric, scissors, and a needle arranged on a work table" />
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">From the sewing room</span>
        <h2>Featured projects</h2>
      </div>
      <a class="text-link" href="/projects/">View all projects</a>
    </div>
    {shownProjects.length ? (
      <div class="card-grid">
        {shownProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <div class="empty-state">The first handmade project will appear here soon.</div>
    )}
  </section>

  <section class="journal-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Notes along the way</span>
          <h2>Latest from the journal</h2>
        </div>
        <a class="text-link" href="/journal/">Read the journal</a>
      </div>
      {journal.length ? journal.slice(0, 3).map((post) => <PostCard post={post} />) : (
        <div class="empty-state">Stories, pattern notes, and lessons learned will appear here soon.</div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    align-items: center;
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    grid-template-columns: 1.05fr 0.95fr;
    min-height: calc(100vh - 5.5rem);
    padding-block: 4rem;
  }

  h1 {
    margin: 0.35rem 0 1.5rem;
  }

  .hero-copy p {
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    max-width: 36rem;
  }

  .button {
    background: var(--rose);
    border-radius: 999px;
    color: white;
    display: inline-block;
    font-weight: 700;
    margin-top: 1rem;
    padding: 0.8rem 1.35rem;
    text-decoration: none;
  }

  .button:hover {
    background: var(--rose-dark);
  }

  .hero-image {
    background: #ead6c6;
    border-radius: 48% 48% 1.5rem 1.5rem;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .journal-section {
    background: #eee7dc;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-image {
      margin-inline: auto;
      max-width: 32rem;
      order: -1;
    }
  }
</style>
