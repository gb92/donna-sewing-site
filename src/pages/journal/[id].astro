---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, isPublished } from "../../lib/content";

export async function getStaticPaths() {
  const posts = (await getCollection("journal")).filter(isPublished);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"journal">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article>
    <header class="post-header container">
      <span class="eyebrow">{formatDate(post.data.publishDate)}</span>
      <h1>{post.data.title}</h1>
      <p>{post.data.summary}</p>
      {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>}
    </header>
    <div class="cover container">
      <Image src={post.data.cover} alt={post.data.coverAlt} />
    </div>
    <div class="prose article-copy"><Content /></div>
  </article>
</BaseLayout>

<style>
  .post-header {
    max-width: 60rem;
    padding-block: clamp(4rem, 10vw, 8rem);
    text-align: center;
  }

  h1 {
    margin: 0.4rem 0 1rem;
  }

  .post-header p {
    color: var(--muted);
    font-size: 1.25rem;
    margin-inline: auto;
    max-width: 42rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .tags span {
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
  }

  .cover :global(img) {
    border-radius: var(--radius);
    max-height: 52rem;
    object-fit: cover;
    width: 100%;
  }

  .article-copy {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
</style>
